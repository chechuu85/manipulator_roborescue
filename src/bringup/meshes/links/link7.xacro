<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="link7">
    <link name="link7">

      <inertial>
        <origin xyz="0 0.0 0.0" rpy="0 0 0"/>
        <mass value="1"/>
        <inertia ixx="0.004233" ixy="0.0" ixz="0.0"
                iyy="0.004233" iyz="0.0"
                izz="0.0018"/>
      </inertial>

      <visual>
        <origin xyz="0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.01"/>
        </geometry>
        <material name="yellow">
          <color rgba="0.8 0.8 0.0 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.01" length="0.01"/>
        </geometry>
      </collision>
      
    </link>
  </xacro:macro>
</robot>