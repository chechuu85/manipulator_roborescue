<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- link9 -> dedo dcha -->
  <xacro:macro name="link9">
    <link name="link9">

      <inertial>
        <origin xyz="0 -0.03 0.05" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0073" ixy="0.0" ixz="0.0"
                iyy="0.006428" iyz="0.0"
                izz="0.001628"/>
      </inertial>

      <visual>
        <origin xyz="0 -0.03 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.01 0.01"/>
        </geometry>
        <material name="white">
          <color rgba="0.9 0.9 0.9 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 -0.03 0.05" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>
</robot>