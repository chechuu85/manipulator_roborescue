<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="link3">
    <link name="link3">

      <inertial>
        <origin xyz="0 0.0 0.235" rpy="0 0 0"/>
        <mass value="3"/>
        <inertia ixx="0.002753" ixy="0.0" ixz="0.0"
                iyy="0.002753" iyz="0.0"
                izz="0.004538"/>
      </inertial>

      <visual>
